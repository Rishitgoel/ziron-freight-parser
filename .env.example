# ==============================================================================
# Ziron Labs Freight Document Intelligence Pipeline Configuration
# ==============================================================================

# OpenAI API Key (Required for live LLM extraction)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection (Default: gpt-4o-mini for cost-effective extraction; gpt-4o for complex docs)
OPENAI_MODEL=gpt-4o-mini

# Optional: Run with mock/deterministic fallback parser when testing without an API key
# Set to 'true' to use the deterministic offline extractor for testing/evaluation
USE_MOCK_PARSER=false
